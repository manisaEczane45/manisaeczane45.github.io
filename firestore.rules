rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /pharmacies/{pharmacyId} {
      // Giriş yapmış herkes (tüm eczaneler) bakiyeleri görebilir.
      allow read: if request.auth != null;
      // Sadece admin custom claim'ine sahip kullanıcılar yazabilir.
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /transactions/{txId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.admin == true;
      // Tek tek işlemler düzenlenemez (şeffaflık için), ama admin panelinden
      // toplu "geçmişi temizle" butonuyla admin hepsini silebilir.
      allow delete: if request.auth != null && request.auth.token.admin == true;
      allow update: if false;
    }
  }
}
