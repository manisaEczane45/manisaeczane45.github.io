rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /pharmacies/{pharmacyId} {
      // Giriş yapmış herkes (tüm eczaneler) bakiyeleri görebilir.
      allow read: if request.auth != null;
      // Sadece admin custom claim'ine sahip kullanıcılar yazabilir.
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /receivables/{receivableId} {
      // Giriş yapmış herkes (tüm eczaneler) alacakları görebilir.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /transactions/{txId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.admin == true;
      // Admin tek bir işlemi düzeltebilir (düzenleme "edited: true" ile işaretlenir,
      // şeffaflık için not kalır) ve admin panelinden toplu "geçmişi temizle"
      // butonuyla hepsini silebilir.
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
